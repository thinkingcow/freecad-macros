import math
import sys
import FreeCAD as App
import FreeCADGui as Gui
import Part

# Qt Binding fallback for PySide6 (FreeCAD 1.1 default) / PySide2 / PySide
try:
    from PySide6 import QtCore, QtWidgets
except ImportError:
    try:
        from PySide2 import QtCore, QtWidgets
    except ImportError:
        from PySide import QtCore, QtWidgets


def get_property_value(obj, property_names):
    """Retrieves a numeric float value for the first matching property name on an object."""
    if not obj:
        return None
    for name in property_names:
        if hasattr(obj, name):
            val = getattr(obj, name)
            if hasattr(val, "Value"):  # Quantity object
                return float(val.Value)
            try:
                return float(val)
            except (ValueError, TypeError):
                pass
    return None


def get_or_create_global_varset(doc):
    """Retrieves or creates the central ChamferGlobal_values VarSet."""
    varset_name = "ChamferGlobal_values"
    varset_obj = doc.getObject(varset_name)
    if not varset_obj:
        varset_obj = doc.addObject("App::VarSet", varset_name)
        varset_obj.Label = varset_name
        varset_obj.addProperty("App::PropertyFloat", "ChamferSize", "Parameters", "Global Chamfer Size")
        varset_obj.addProperty("App::PropertyEnumeration", "ChamferSide", "Parameters", "Global Chamfer Side")
        varset_obj.ChamferSide = ["Both", "Top", "Bottom"]
        varset_obj.ChamferSize = 1.0
        varset_obj.ChamferSide = "Both"
    return varset_obj


class GearSelectionDialog(QtWidgets.QDialog):
    """Dialog displaying gear selection list, chamfer size, and side options."""

    def __init__(self, gear_objects, doc, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Select Gears & Chamfer Options")
        self.resize(400, 400)

        layout = QtWidgets.QVBoxLayout(self)

        label = QtWidgets.QLabel("Select one or more gears to chamfer:")
        layout.addWidget(label)

        # List widget with checkable gear items
        self.list_widget = QtWidgets.QListWidget()
        for obj in gear_objects:
            item = QtWidgets.QListWidgetItem(obj.Label)
            item.setFlags(item.flags() | QtCore.Qt.ItemIsUserCheckable)
            item.setCheckState(QtCore.Qt.Checked)  # Default all checked
            item.setData(QtCore.Qt.UserRole, obj)
            self.list_widget.addItem(item)
        layout.addWidget(self.list_widget)

        # Select All / Deselect All convenience buttons
        btn_layout = QtWidgets.QHBoxLayout()
        select_all_btn = QtWidgets.QPushButton("Select All")
        deselect_all_btn = QtWidgets.QPushButton("Deselect All")
        select_all_btn.clicked.connect(lambda: self.set_all_checked(True))
        deselect_all_btn.clicked.connect(lambda: self.set_all_checked(False))
        btn_layout.addWidget(select_all_btn)
        btn_layout.addWidget(deselect_all_btn)
        layout.addLayout(btn_layout)

        # Fetch existing global values if available for defaults
        global_varset = doc.getObject("ChamferGlobal_values")
        default_size = float(global_varset.ChamferSize) if global_varset and hasattr(global_varset, "ChamferSize") else 1.0
        default_side = global_varset.ChamferSide if global_varset and hasattr(global_varset, "ChamferSide") else "Both"

        # Side selection dropdown
        side_layout = QtWidgets.QHBoxLayout()
        side_layout.addWidget(QtWidgets.QLabel("Chamfer Side:"))
        self.side_combo = QtWidgets.QComboBox()
        self.side_combo.addItems(["Both (Top & Bottom)", "Top Only", "Bottom Only"])
        
        if default_side == "Top":
            self.side_combo.setCurrentIndex(1)
        elif default_side == "Bottom":
            self.side_combo.setCurrentIndex(2)
        else:
            self.side_combo.setCurrentIndex(0)

        side_layout.addWidget(self.side_combo)
        layout.addLayout(side_layout)

        # Chamfer size input field
        size_layout = QtWidgets.QHBoxLayout()
        size_layout.addWidget(QtWidgets.QLabel("Chamfer Size (mm):"))
        self.chamfer_spin = QtWidgets.QDoubleSpinBox()
        self.chamfer_spin.setRange(0.01, 100.0)
        self.chamfer_spin.setValue(default_size)
        self.chamfer_spin.setDecimals(2)
        self.chamfer_spin.setSingleStep(0.25)
        size_layout.addWidget(self.chamfer_spin)
        layout.addLayout(size_layout)

        # OK / Cancel buttons
        button_box = QtWidgets.QDialogButtonBox(
            QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel
        )
        button_box.accepted.connect(self.accept)
        button_box.rejected.connect(self.reject)
        layout.addWidget(button_box)

    def set_all_checked(self, checked):
        state = QtCore.Qt.Checked if checked else QtCore.Qt.Unchecked
        for i in range(self.list_widget.count()):
            self.list_widget.item(i).setCheckState(state)

    def get_selected_gears(self):
        selected = []
        for i in range(self.list_widget.count()):
            item = self.list_widget.item(i)
            if item.checkState() == QtCore.Qt.Checked:
                selected.append(item.data(QtCore.Qt.UserRole))
        return selected

    def get_chamfer_size(self):
        return self.chamfer_spin.value()

    def get_chamfer_side(self):
        txt = self.side_combo.currentText()
        if "Top" in txt and "Bottom" in txt:
            return "Both"
        elif "Top" in txt:
            return "Top"
        else:
            return "Bottom"


class ChamferedGearFeature:
    """Parametric FeaturePython class linked to central global chamfer VarSet with static fallback[cite: 1]."""

    def __init__(self, obj):
        obj.Proxy = self
        obj.addProperty("App::PropertyLink", "SourceGear", "Parameters", "Source gear object")
        obj.addProperty("App::PropertyFloat", "ChamferSize", "Parameters", "Chamfer size in mm")
        obj.addProperty("App::PropertyEnumeration", "ChamferSide", "Parameters", "Chamfer side")
        obj.ChamferSide = ["Both", "Top", "Bottom"]

    def execute(self, obj):
        gear_obj = obj.SourceGear
        if not gear_obj or not hasattr(gear_obj, "Shape"):
            return

        doc = obj.Document
        global_varset = doc.getObject("ChamferGlobal_values")

        # If global VarSet exists, sync/read from it. If deleted, fall back to object's current static values.
        if global_varset and hasattr(global_varset, "ChamferSize") and hasattr(global_varset, "ChamferSide"):
            chamfer_size = float(global_varset.ChamferSize)
            side_val = global_varset.ChamferSide
            chamfer_side = side_val if isinstance(side_val, str) else ["Both", "Top", "Bottom"][side_val]
            obj.ChamferSize = chamfer_size
            obj.ChamferSide = chamfer_side
        else:
            chamfer_size = float(obj.ChamferSize)
            side_val = obj.ChamferSide
            chamfer_side = side_val if isinstance(side_val, str) else ["Both", "Top", "Bottom"][side_val]

        is_ring_gear = "Ring" in gear_obj.Label

        varset_label = (
            gear_obj.Label[:-5] + "_values"
            if gear_obj.Label.endswith("_Body")
            else gear_obj.Label + "_values"
        )

        varset_obj = None
        for o in doc.Objects:
            if o.Label == varset_label or o.Name == varset_label:
                varset_obj = o
                break

        height_keys = ["Height", "height"]
        outer_dia_keys = ["OuterDiameter", "outerDiameter", "Outer_Diameter", "outer_diameter"]
        inner_dia_keys = ["InnerDiameter", "innerDiameter", "Inner_Diameter", "inner_diameter"]

        height = get_property_value(varset_obj, height_keys) or get_property_value(gear_obj, height_keys)
        outer_diameter = get_property_value(varset_obj, outer_dia_keys) or get_property_value(gear_obj, outer_dia_keys)

        inner_diameter = None
        if is_ring_gear:
            inner_diameter = get_property_value(varset_obj, inner_dia_keys) or get_property_value(gear_obj, inner_dia_keys)

        if height is None or outer_diameter is None or (is_ring_gear and inner_diameter is None):
            App.Console.PrintWarning(f"ChamferedGear: Missing required dimension properties for '{gear_obj.Label}'\n")
            return

        placement = (
            gear_obj.getGlobalPlacement()
            if hasattr(gear_obj, "getGlobalPlacement")
            else gear_obj.Placement
        )

        global_local_bottom = placement.multVec(App.Vector(0, 0, 0))
        global_local_top = placement.multVec(App.Vector(0, 0, height))

        if is_ring_gear:
            outer_r = outer_diameter / 2.0
            inner_r = inner_diameter / 2.0
            outer_cyl = Part.makeCylinder(outer_r, height)
            inner_cyl = Part.makeCylinder(inner_r, height)
            tube_shape = outer_cyl.cut(inner_cyl)

            all_inner_edges = [
                e for e in tube_shape.Edges
                if isinstance(e.Curve, Part.Circle) and math.isclose(e.Curve.Radius, inner_r, abs_tol=1e-3)
            ]
            local_top_edges = [e for e in all_inner_edges if math.isclose(e.Curve.Center.z, height, abs_tol=1e-3)]
            local_bottom_edges = [e for e in all_inner_edges if math.isclose(e.Curve.Center.z, 0.0, abs_tol=1e-3)]
        else:
            radius = outer_diameter / 2.0
            cyl_shape = Part.makeCylinder(radius, height)
            all_edges = [e for e in cyl_shape.Edges if isinstance(e.Curve, Part.Circle)]
            local_top_edges = [e for e in all_edges if math.isclose(e.Curve.Center.z, height, abs_tol=1e-3)]
            local_bottom_edges = [e for e in all_edges if math.isclose(e.Curve.Center.z, 0.0, abs_tol=1e-3)]

        if global_local_top.z >= global_local_bottom.z:
            world_top_edges = local_top_edges
            world_bottom_edges = local_bottom_edges
        else:
            world_top_edges = local_bottom_edges
            world_bottom_edges = local_top_edges

        if chamfer_side == "Top":
            target_edges = world_top_edges
        elif chamfer_side == "Bottom":
            target_edges = world_bottom_edges
        else:
            target_edges = world_top_edges + world_bottom_edges

        if not target_edges:
            App.Console.PrintWarning(f"ChamferedGear: Failed identifying target edges on '{gear_obj.Label}'\n")
            return

        if is_ring_gear:
            cutter_shape = tube_shape.makeChamfer(chamfer_size, target_edges)
        else:
            cutter_shape = cyl_shape.makeChamfer(chamfer_size, target_edges)

        cutter_shape.Placement = placement
        obj.Shape = gear_obj.Shape.common(cutter_shape)


class _ViewProviderChamferedGear:
    """View provider for the parametric chamfered gear feature."""

    def __init__(self, vobj):
        vobj.Proxy = self

    def getIcon(self):
        return """
            <?xml version="1.0" encoding="UTF-8"?>
            <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
              <path d="M10 10 h44 v44 h-44 z" fill="#336699" stroke="#ffffff" stroke-width="2"/>
            </svg>
            """

    def attach(self, vobj):
        self.ViewObject = vobj

    def claimChildren(self):
        return []

    def getDisplayModes(self, vobj):
        return []

    def updateData(self, feature, property):
        return

    def onChanged(self, vobj, prop):
        return

    def __getstate__(self):
        return None

    def __setstate__(self, state):
        return None


# Register both classes to __main__ so FreeCAD can locate them upon loading/recomputing
setattr(sys.modules['__main__'], 'ChamferedGearFeature', ChamferedGearFeature)
setattr(sys.modules['__main__'], '_ViewProviderChamferedGear', _ViewProviderChamferedGear)


def process_gear(doc, gear_obj, chamfer_size, chamfer_side):
    """Creates a parametric ChamferedGearFeature linked to the global VarSet."""
    res_name = f"{gear_obj.Name}_chamfered"
    res_label = f"{gear_obj.Label}_chamfered"

    res_obj = doc.addObject("Part::FeaturePython", res_name)
    res_obj.Label = res_label
    ChamferedGearFeature(res_obj)

    res_obj.SourceGear = gear_obj
    res_obj.ChamferSize = chamfer_size
    res_obj.ChamferSide = chamfer_side

    if App.GuiUp:
        _ViewProviderChamferedGear(res_obj.ViewObject)

    if hasattr(gear_obj, "ViewObject") and gear_obj.ViewObject:
        gear_obj.ViewObject.Visibility = False

    return True, None


def main():
    doc = App.ActiveDocument
    if not doc:
        QtWidgets.QMessageBox.warning(None, "Macro Error", "No active document found.")
        return

    gear_objects = [
        obj for obj in doc.Objects if "Gear" in obj.Label and obj.Label.endswith("_Body")
    ]

    if not gear_objects:
        QtWidgets.QMessageBox.information(
            None,
            "No Gears Found",
            "No objects containing 'Gear' and ending with '_Body' were found in the active document.",
        )
        return

    global_varset = get_or_create_global_varset(doc)

    dialog = GearSelectionDialog(gear_objects, doc)
    
    if dialog.exec() != QtWidgets.QDialog.Accepted:
        return

    selected_gears = dialog.get_selected_gears()
    chamfer_size = dialog.get_chamfer_size()
    chamfer_side = dialog.get_chamfer_side()

    if not selected_gears:
        return

    global_varset.ChamferSize = chamfer_size
    global_varset.ChamferSide = chamfer_side

    errors = []
    processed_count = 0

    for gear_obj in selected_gears:
        success, error_msg = process_gear(doc, gear_obj, chamfer_size, chamfer_side)
        if success:
            processed_count += 1
        else:
            errors.append(error_msg)

    doc.recompute()

    if errors:
        msg = f"Processed {processed_count} gear(s).\n\nErrors encountered:\n" + "\n".join(
            f"- {e}" for e in errors
        )
        QtWidgets.QMessageBox.warning(None, "Batch Processing Results", msg)
    else:
        QtWidgets.QMessageBox.information(
            None,
            "Success",
            f"Successfully applied global parametric chamfer ({chamfer_size:.2f} mm, {chamfer_side}) to {processed_count} gear(s).",
        )


if __name__ == "__main__":
    main()